    "dae": {
      "macro": {
        "name": "剑刃风暴 Whirlwind Attack",
        "img": "icons/skills/melee/sword-twirl-orange.webp",
        "type": "script",
        "scope": "global",
        "command": "const attacks = macroItem.actor.items.contents\n  .filter(item => item.type === \"weapon\")\n  .flatMap(item => item.system.activities.filter(activity =>\n    activity.type === \"attack\" && activity.getActionType() === \"mwak\"\n  ));\nif (!attacks.length) return;\n\nconst uuid = attacks.length === 1 ? attacks[0].uuid\n  : await dnd5eClasspack.dialogUtils.buttonDialog(\n    \"选择近战攻击\", \"\",\n    attacks.map(activity => [\n      `${activity.item.name} · ${activity.name}`,\n      activity.uuid,\n      { image: activity.item.img }\n    ])\n  );\nif (!uuid) return;\n\nconst attack = fromUuidSync(uuid);\nconst attackMode = attack.item.system.attackModes.find(mode =>\n  attack.getActionType(mode.value) === \"mwak\"\n)?.value;\n\nfor (const target of [...workflow.targets]) {\n  await MidiQOL.completeActivityUse(uuid, {\n    attackMode,\n    consume: { resources: true, spellSlot: false, action: false },\n    midiOptions: {\n      targetUuids: [target.document.uuid],\n      ignoreUserTargets: true,\n      workflowOptions: { targetConfirmation: \"never\" }\n    }\n  }, { configure: false }, { create: true });\n}",
        "author": "dvg25zW2MvzsvMOU",
        "ownership": {
          "default": 3
        },
