    "dae": {
      "macro": {
        "name": "法术窃贼 Spell Thief",
        "img": "icons/magic/control/orb-web-hold.webp",
        "type": "script",
        "scope": "global",
        "command": "const pass = args[0].macroPass;\nconst defender = macroItem.actor;\nconst request = workflow.workflowOptions.spellThief;\n\n// 能力自身的豁免行动：在拥有者客户端记录反应并配置这次豁免。\nif (pass === \"preItemRoll\" && request) {\n  const activity = workflow.activity;\n  activity.updateSource({\n    \"save.ability\": [request.ability],\n    ...(request.steal ? {} : { effects: [] })\n  });\n  args[0].options.dialog.configure = false;\n  await MidiQOL.setReactionUsed(defender);\n  return;\n}\n\n// 禁施 AE 通过同一 ItemMacro 检查施法者的后续法术。\nif (pass === \"preItemRoll\") {\n  if (workflow.item.type !== \"spell\") return;\n  const blocked = workflow.actor.effects.some(e => {\n    const state = e.getFlag(\"world\", \"spellThief\");\n    return e.active && state && (\n      state.spell === workflow.item.uuid\n      || state.identifier === workflow.item.identifier\n    );\n  });\n  if (blocked) {\n    ui.notifications.warn(`法术窃取：当前无法施展「${workflow.item.name}」。`);\n    return false;\n  }\n  return;\n}\n\nif (pass !== \"isTargeted\" || workflow.aborted || workflow.item.type !== \"spell\") return;\nif (MidiQOL.hasUsedReaction(defender)) return;\n\nconst userId = dnd5eClasspack.firstOwner(defender, true);\nconst level = workflow.spellLevel;\nconst eligible = level >= 1 && Object.values(defender.system.spells).some(\n  slot => slot.max > 0 && slot.level >= level\n);\nconst confirmed = await dnd5eClasspack.dialogUtils.confirm(\n  \"法术窃取\",\n  `<p>是否使用反应抵御「${foundry.utils.escapeHTML(workflow.item.name)}」？</p>`,\n  { userId }\n);\nif (!confirmed) return;\n\nconst feature = await fromUuid(macroItem.uuid);\nconst save = feature.system.activities.find(a => a.identifier === \"spell-thief-save\");\nconst steal = eligible;\n\nconst result = await MidiQOL.completeActivityUse(\n  save.uuid,\n  {\n    consume: { resources: true, spellSlot: false, action: false },\n    midiOptions: {\n      asUser: userId,\n      workflowData: true,\n      targetUuids: [workflow.token.document.uuid],\n      ignoreUserTargets: true,\n      workflowOptions: {\n        noProvokeReaction: true,\n        noTargetOnUseMacro: true,\n        spellThief: { ability: workflow.activity.spellcastingAbility, steal }\n      }\n    }\n  },\n  { configure: false },\n  { create: true }\n);\nif (!result?.failedSaves?.has(workflow.token)) return;\n\nconst target = args[0].options.token;\nif (workflow.targets.size === 1) workflow.aborted = true;\nelse {\n  workflow.targets.delete(target);\n  workflow.hitTargets.delete(target);\n  workflow.hitTargetsEC.delete(target);\n}\n\nif (!steal) return;\n\nconst effect = workflow.actor.effects.find(\n  e => e.system?.origin?.message === result.itemCardUuid\n);\nif (!effect) return ui.notifications.warn(\"法术窃取：未找到豁免行动应用的禁施效果。\");\n\nawait MidiQOL.socket().executeAsGM(\"updateEffects\", {\n  actorUuid: workflow.actor.uuid,\n  updates: [{\n    _id: effect.id,\n    \"flags.world.spellThief\": {\n      spell: workflow.item.uuid, identifier: workflow.item.identifier\n    }\n  }]\n});\n\nconst source = await fromUuid(workflow.item.uuid) ?? workflow.item;\nconst data = source.toObject();\ndelete data._id;\ndata.name = `${source.name}（窃取）`;\ndata.system.method = \"spell\";\ndata.system.prepared = CONFIG.DND5E.spellPreparationStates.always.value;\ndata.system.ability = defender.spellcastingAbility;\ndata.system.sourceItem = \"\";\ndata.flags.dnd5e ??= {};\ndata.flags.dnd5e.dependentOn = effect.uuid;\ndelete data.flags.dnd5e.cachedFor;\ndelete data.flags.dnd5e.scaling;\ndata.system.uses = { spent: 0, max: \"\", recovery: [] };\nfor (const activity of Object.values(data.system.activities)) {\n  // NPC 的每日次数不转移给盗取者；实际施法行动改用自己的法术位。\n  activity.uses = { spent: 0, max: \"\", recovery: [] };\n  activity.consumption.targets = [];\n  if (activity._id !== workflow.activity.id) continue;\n  activity.consumption.spellSlot = true;\n  if (activity.save) {\n    activity.save.dc.calculation = \"spellcasting\";\n    activity.save.dc.formula = \"\";\n  }\n  if (activity.attack) {\n    if (activity.attack.flat) activity.attack.bonus = \"\";\n    activity.attack.ability = \"spellcasting\";\n    activity.attack.flat = false;\n  }\n}\nawait dnd5eClasspack.createActorItems(defender.uuid, data, { favorite: true });",
