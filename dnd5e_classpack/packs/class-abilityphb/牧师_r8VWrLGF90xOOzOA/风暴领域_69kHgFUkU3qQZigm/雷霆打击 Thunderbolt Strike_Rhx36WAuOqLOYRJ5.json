    "dae": {
      "macro": {
        "name": "雷霆打击 Thunderbolt Strike",
        "img": "icons/magic/lightning/bolt-strike-beam-yellow.webp",
        "type": "script",
        "scope": "global",
        "command": "if (args[0].macroPass !== \"postActiveEffects\") return;\n\nfor (const damage of workflow.damageList ?? []) {\n  if (!damage.damageDetail.some(d =>\n    d.type === \"lightning\" && d.value > 0\n  )) continue;\n\n  const target = (await fromUuid(damage.targetUuid)).object;\n  if (![\"tiny\", \"sm\", \"med\", \"lg\"].includes(\n    target.actor.system.traits.size\n  )) continue;\n\n  const push = await dnd5eClasspack.dialogUtils.confirm(\n    \"雷霆打击\",\n    `<p>是否推动 ${foundry.utils.escapeHTML(target.name)}？</p>`\n  );\n  if (!push) continue;\n\n  const distance = await dnd5eClasspack.dialogUtils.numberDialog(\n    \"雷霆打击\",\n    \"\",\n    {\n      label: `${target.name}：推动距离（尺）`,\n      name: \"distance\",\n      options: { currentValue: 10, min: 0, max: 10, step: 1 }\n    }\n  );\n\n  const feet = Math.clamp(Number(distance) || 0, 0, 10);\n  if (!feet) continue;\n\n  await dnd5eClasspack.push(\n    target,\n    workflow.token,\n    feet,\n    { animate: true, checkCollision: true }\n  );\n}",
        "author": "dvg25zW2MvzsvMOU",
