    "dae": {
      "macro": {
        "name": "熵光结界 Entropic Ward",
        "type": "script",
        "command": "const pass = args[0].macroPass;\nconst feature = macroItem;\nconst defender = feature.actor;\nconst counterId = \"368d3ab4828aa73a\";\nconst advantageKey = \"flags.midi-qol.advantage.attack.all\";\n\nif (pass === \"postAttackRoll\") {\n  const counters = defender.effects.filter(effect => {\n    const attackerUuid = effect.getFlag(\"dnd5e_classpack\", \"entropicWardAttacker\");\n    return effect.active && attackerUuid\n      && workflow.targets.documents.some(target => target.actor?.uuid === attackerUuid);\n  });\n  if (counters.length) await MidiQOL.removeEffects({\n    actorUuid: defender.uuid, effects: counters.map(effect => effect.id)\n  });\n  return;\n}\n\nif (pass === \"isMissed\") {\n  if (workflow.classpackEntropicWard !== defender.uuid) return;\n  delete workflow.classpackEntropicWard;\n\n  const attackerUuid = workflow.actor.uuid;\n  const counter = feature.effects.get(counterId).toObject();\n  delete counter._id;\n  counter.system.origin = { item: feature.uuid, actor: defender.uuid };\n  counter.flags.dnd5e_classpack.entropicWardAttacker = attackerUuid;\n  counter.system.changes.find(change => change.key === advantageKey).value =\n    `targetActorUuid === ${JSON.stringify(attackerUuid)}`;\n\n  await MidiQOL.createEffects({ actorUuid: defender.uuid, effects: [counter] });\n  return;\n}\n\nif (pass !== \"isPreAttacked\" || workflow.aborted || workflow.targets.count !== 1) return;\nif (workflow.classpackEntropicWard || feature.system.uses.value < 1 || MidiQOL.hasUsedReaction(defender)\n  || MidiQOL.checkIncapacitated(defender, false, false)) return;\n\nconst userId = dnd5eClasspack.firstOwner(defender, true);\nif (!userId) return;\nconst attacker = foundry.utils.escapeHTML(workflow.tokenDocument?.name ?? workflow.actor.name);\nconst confirmed = await dnd5eClasspack.dialogUtils.confirm(\n  feature.name, `<p>是否使用反应，使「${attacker}」的这次攻击检定具有劣势？</p>`, { userId }\n);\nif (!confirmed || workflow.aborted || MidiQOL.hasUsedReaction(defender)) return;\n\nconst result = await MidiQOL.completeActivityUse(feature.system.activities.contents[0].uuid, {\n  consume: { resources: true, spellSlot: false, action: false },\n  midiOptions: {\n    asUser: userId, workflowData: true,\n    workflowOptions: { entropicWard: true, noProvokeReaction: true, noTargetOnUseMacro: true }\n  }\n}, { configure: false });\nif (!result?.itemCardUuid || result.aborted) return;\n\nworkflow.classpackEntropicWard = defender.uuid;\n"
      }
    }
  },
