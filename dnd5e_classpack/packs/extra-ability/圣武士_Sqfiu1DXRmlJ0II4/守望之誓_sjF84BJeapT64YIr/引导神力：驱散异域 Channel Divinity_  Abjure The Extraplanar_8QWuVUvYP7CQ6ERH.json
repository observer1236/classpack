    "dae": {
      "macro": {
        "name": "引导神力：驱散异域 Channel Divinity: Abjure The Extraplanar.",
        "img": "icons/magic/holy/barrier-shield-winged-cross.webp",
        "type": "script",
        "scope": "global",
        "command": "if (args[0]?.macroPass !== \"preItemRoll\") return;\nconst source = workflow.token?.object ?? workflow.token;\nif (!source?.actor) return false;\nconst valid = new Set([\"aberration\", \"celestial\", \"elemental\", \"fey\", \"fiend\"]);\nconst distance = dnd5e.utils.convertLength(30, \"ft\", canvas.scene.grid.units, { strict: false });\nconst deafened = CONFIG.specialStatusEffects?.DEAF ?? \"deafened\";\nconst targets = MidiQOL.findNearby(null, source, distance, {\n  includeToken: false, includeIncapacitated: true, canSee: false, isSeen: false\n}).filter(target => target.id !== source.id && target.actor\n  && valid.has(target.actor.system.details.type?.value)\n  && !target.actor.statuses.has(deafened));\nawait dnd5eClasspack.updateTargets(targets);\nworkflow.setTargets(new Set(targets));\nconst usage = args[0].options?.usage;\nif (usage) {\n  usage.midiOptions ??= {};\n  usage.midiOptions.targetsToUse = new Set(targets);\n  usage.midiOptions.ignoreUserTargets = true;\n}\nif (!targets.length) {\n  ui.notifications.warn(\"驱散异域：30 尺内没有符合类型且能够听见祷言的目标。\");\n  return false;\n}\n",
        "author": "WqWGW8MuBm7BNHxt",
