    {
      "_id": "QZ9tKs1Oc3Gxrqlb",
      "name": "触须 Tentacles",
      "type": "weapon",
      "system": {
        "source": {
          "custom": "",
          "book": "MM'14",
          "page": "37",
          "license": "",
          "rules": "2014",
          "revision": 1
        },
        "description": {
          "value": "<p>近战武器攻击：命中+8，触及10尺，单一生物。命中：4（[[/damage 1d4 + 2 type=poison]]）点毒素伤害，目标必须进行一次DC 13的体质豁免，豁免失败则中毒1分钟，并在中毒期间陷入麻痹。目标可以在每个其自己回合结束时再进行一次该豁免，豁免成功则该中毒效应终止。</p>",
          "chat": ""
        },
        "range": {
