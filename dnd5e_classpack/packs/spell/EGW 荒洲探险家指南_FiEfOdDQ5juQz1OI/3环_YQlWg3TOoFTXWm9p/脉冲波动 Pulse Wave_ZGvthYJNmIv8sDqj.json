    "dae": {
      "macro": {
        "name": "脉冲波动 Pulse Wave",
        "img": "icons/magic/sonic/projectile-shock-wave-blue.webp",
        "type": "script",
        "scope": "global",
        "command": "const caster = workflow.token;\nconst targets = workflow.failedSaves.documents.filter(target => target.id !== caster.id);\nif (!targets.length) return;\n\nconst direction = await dnd5eClasspack.dialogUtils.buttonDialog(\n  workflow.item.name, \"选择将豁免失败的目标推离还是拉近。\",\n  [[\"推离\", \"push\"], [\"拉近\", \"pull\"]]\n);\nif (!direction) return;\n\nconst feet = 15 + 5 * Math.max(0, workflow.spellLevel - 3);\nconst units = caster.document.parent.grid.units;\nconst distance = dnd5e.utils.convertLength(feet, \"ft\", units, { strict: false });\nawait dnd5eClasspack.push(targets, caster, direction === \"pull\" ? -distance : distance, { avoidOccupied: true });\n",
        "author": "WqWGW8MuBm7BNHxt",
        "ownership": {
          "default": 3
        },
