{
  "name": "崩坏现实Reality Break",
  "type": "spell",
  "flags": {
    "midiProperties": {
      "confirmTargets": "always",
      "otherSaveDamage": "fulldam",
      "autoFailFriendly": false,
      "autoSaveFriendly": false,
      "critOther": false,
      "offHandWeapon": false,
      "magicdam": false,
      "magiceffect": false,
      "concentration": true,
