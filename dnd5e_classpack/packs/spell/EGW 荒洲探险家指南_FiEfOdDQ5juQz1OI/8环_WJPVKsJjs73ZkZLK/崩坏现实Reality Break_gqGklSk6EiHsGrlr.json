    },
    "midi-qol": {
      "rollAttackPerTarget": "always",
      "itemCondition": "",
      "otherCondition": "",
      "effectCondition": "",
      "removeAttackDamageButtons": "default",
      "reactionCondition": "",
      "onUseMacroName": "[preItemRoll]ItemMacro,[postActiveEffects]ItemMacro"
