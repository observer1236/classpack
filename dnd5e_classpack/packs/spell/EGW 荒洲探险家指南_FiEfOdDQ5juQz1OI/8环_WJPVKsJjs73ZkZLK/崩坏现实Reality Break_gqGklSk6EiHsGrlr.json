    "dnd5e": {},
    "dae": {
      "macro": {
        "name": "崩坏现实Reality Break",
        "img": "icons/magic/lightning/orb-ball-purple.webp",
        "type": "script",
        "scope": "global",
        "command": "const pass = args[0]?.macroPass;\nconst cast = typeof workflow === \"undefined\" ? null : workflow;\nif (!cast || cast.aborted) return;\nconst api = globalThis.dnd5eClasspack;\nconst START = \"cpRealityStart01\";\nconst BRANCHES = { far: \"cpRealityFar0001\", rift: \"cpRealityRift001\", worm: \"cpRealityWorm001\", cold: \"cpRealityCold001\" };\nconst stateOf = effect => effect.flags?.dnd5e_classpack?.realityBreak;\nconst live = effect => effect && effect.active !== false && !effect.disabled && !effect.isSuppressed;\nasync function updateEffect(effect, updates) {\n  if (effect.isOwner || game.user.isGM) return effect.update(updates);\n  const result = await MidiQOL.socket().executeAsGM(\"updateEffects\", {\n    actorUuid: effect.parent.uuid, updates: [{ _id: effect.id, ...updates }]\n  });\n  if (result === false || result === \"gmBlocked\") throw new Error(\"无法更新崩坏现实效应\");\n}\nconst branch = cast.workflowOptions?.classpackRealityBranch;\nconst overtimeUuid = cast.workflowOptions?.overTimeEffectUuid;\nif (pass === \"preItemRoll\" && Object.values(BRANCHES).includes(cast.activity.id) && !branch) return false;\nif (pass === \"preItemRoll\" && cast.activity.id === START) {\n  const effect = overtimeUuid ? await fromUuid(overtimeUuid) : null;\n  if (!live(effect) || !stateOf(effect)?.dc) return false;\n  if (!cast.item?.flags?.[\"midi-qol\"]?.syntheticItem) return false;\n  // ActivityOverTime 创建的是临时物品副本。掷表不是目标重新施法，不能被沉默或失能拦住。\n  Object.defineProperty(cast.activity, \"isSpell\", { value: false, configurable: true });\n  cast.workflowOptions.allowIncapacitated = true;\n  const usage = args[0].options?.usage;\n  if (usage) {\n    usage.midiOptions ??= {};\n    usage.midiOptions.workflowOptions ??= {};\n    usage.midiOptions.workflowOptions.allowIncapacitated = true;\n  }\n  return;\n}\nif (pass !== \"postActiveEffects\") return;\nif (branch) {\n  const main = await fromUuid(branch.effectUuid);\n  for (const target of cast.targets) {\n    if (branch.key === \"worm\") await MidiQOL.socket().executeAsGM(\"toggleStatusEffect\", {\n      actorUuid: target.actor.uuid, statusId: \"prone\", options: { active: true }\n    });\n    if ([\"far\", \"cold\"].includes(branch.key)) {\n      const effects = target.actor.effects.filter(e => e.system?.origin?.message === cast.itemCardUuid);\n      if (live(main)) for (const effect of effects) await updateEffect(effect, {\n        \"flags.dnd5e.dependentOn\": main.uuid, \"flags.dae.expiryMode\": \"delete\"\n      });\n      else if (effects.length) await MidiQOL.socket().executeAsGM(\"removeEffects\", {\n        actorUuid: target.actor.uuid, effects: effects.map(e => e.id)\n      });\n    }\n  }\n  return;\n}\nif (cast.activity.id !== START) {\n  if (cast.activity.id !== \"dnd5eactivity000\") return;\n  if (overtimeUuid || cast._classpackRealitySetup) return;\n  cast._classpackRealitySetup = true;\n  const dc = Number(cast.activity.save?.dc?.value);\n  if (!(dc > 0)) throw new Error(\"崩坏现实：无法确定本次施法 DC\");\n  for (const target of cast.failedSaves ?? []) {\n    const effects = target.actor?.effects.filter(e => DAE.getEffectSource(e).messageUuid === cast.itemCardUuid\n      && DAE.effectMatchesSource(e, cast.item.uuid)) ?? [];\n    for (const effect of effects) {\n      if (stateOf(effect)) continue;\n      await updateEffect(effect, {\n        \"flags.dnd5e_classpack.realityBreak\": { dc, tokenUuid: cast.token?.document?.uuid ?? cast.tokenUuid }\n      });\n    }\n  }\n  return;\n}\nif (cast._classpackRealityStartDone) return;\ncast._classpackRealityStartDone = true;\nconst main = overtimeUuid ? await fromUuid(overtimeUuid) : null;\nif (!live(main) || !stateOf(main)?.dc) return;\nconst state = stateOf(main);\nconst target = Array.from(cast.targets ?? [])[0];\nif (!target?.actor || target.actor.uuid !== main.parent.uuid) return;\nconst roll = cast.utilityRoll ?? cast.utilityRolls?.[0];\nconst result = Number(roll?.total);\nif (!Number.isInteger(result) || result < 1 || result > 10) throw new Error(\"崩坏现实：缺少有效的 d10 掷表结果\");\nconst turn = game.combat?.active ? `${game.combat.uuid}:${game.combat.round}:${game.combat.turn}:${target.document.uuid}` : cast.id;\nif (state.lastStart === turn) return;\nawait updateEffect(main, { \"flags.dnd5e_classpack.realityBreak.lastStart\": turn });\nconst key = result <= 2 ? \"far\" : result <= 5 ? \"rift\" : result <= 8 ? \"worm\" : \"cold\";\nconst source = DAE.getEffectItem(main);\nif (!source) throw new Error(\"崩坏现实：来源物品与来源聊天卡均不可用\");\nif (key === \"worm\") {\n  const casterDoc = state.tokenUuid ? await fromUuid(state.tokenUuid) : null;\n  if (casterDoc?.object && casterDoc.parent === target.document.parent) {\n    const sightOrigin = { ...casterDoc.getCenterPoint(), elevation: casterDoc.elevation };\n    const range = dnd5e.utils.convertLength(30, \"ft\", target.document.parent.grid.units, { strict: false });\n    let placement;\n    try { placement = await api.teleport([target], target, {\n      centerpoint: target, range, avoidOccupied: true, animate: false, animation: \"none\",\n      crosshairsConfig: { label: \"崩坏现实：虫洞落点\" },\n      validityFunctions: [point => !casterDoc.object.checkCollision(point, { origin: sightOrigin, type: \"sight\", mode: \"any\" })]\n    }); } catch (error) { console.error(\"崩坏现实：虫洞传送失败\", error); }\n    if (!placement?.valid || placement.cancelled || placement.movement?.[target.id] !== true) {\n      ui.notifications.warn(\"崩坏现实：传送未完成，请手动处理落点；伤害与倒地仍会结算。\");\n    }\n  } else ui.notifications.warn(\"崩坏现实：施法者不在当前场景，请手动处理虫洞落点；伤害与倒地仍会结算。\");\n}\nif (!live(await fromUuid(main.uuid))) return;\nconst id = BRANCHES[key], path = `system.activities.${id}`;\nconst updates = { \"system.properties\": [...source.system.properties].filter(p => p !== \"concentration\") };\nif (key === \"rift\") Object.assign(updates, {\n  [`${path}.save.dc.calculation`]: \"\", [`${path}.save.dc.formula`]: String(state.dc), [`${path}.save.dc.bonus`]: \"\"\n});\nconst copy = source.clone(updates, { keepId: true });\nconst activity = copy.system.activities.get(id);\nif (!activity) throw new Error(\"崩坏现实：来源物品缺少结果 Activity，请更新法术条目\");\nawait MidiQOL.completeActivityUse(activity, {\n  consume: false, create: { measuredTemplate: false }, concentration: { begin: false },\n  midiOptions: { targetsToUse: new Set([target]), ignoreUserTargets: true, workflowData: true,\n    proceedChecks: { checkComponents: false },\n    workflowOptions: { targetConfirmation: \"none\", noProvokeReaction: true, allowIncapacitated: true, isOverTime: true,\n      classpackRealityBranch: { effectUuid: main.uuid, key } } }\n}, { configure: false }, { create: true });\n",
        "author": "WqWGW8MuBm7BNHxt",
        "ownership": {
          "default": 3
        },
