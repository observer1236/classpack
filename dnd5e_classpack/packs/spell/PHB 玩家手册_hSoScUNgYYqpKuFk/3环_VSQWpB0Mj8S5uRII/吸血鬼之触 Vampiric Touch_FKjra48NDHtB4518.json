    "dnd5e": {},
    "dae": {
      "macro": {
        "name": "吸血鬼之触 Vampiric Touch",
        "img": "icons/magic/unholy/hand-claw-glow-orange.webp",
        "type": "script",
        "scope": "global",
        "command": "const sustainId = \"cpVampTouch00001\";\nconst sustainEffectId = \"cpVampTouchSelf1\";\nconst concentrationFlag = \"vampiricTouchConcentration\";\nconst hiddenPath = `system.activities.${sustainId}.flags.dnd5e_classpack.hidden`;\n\nif (args[0] === \"off\") {\n  const spell = await fromUuid(macroItem.uuid);\n  const concentration = args.at(-1).efData.system.origin.effect;\n  if (spell?.getFlag(\"dnd5e_classpack\", concentrationFlag) !== concentration) return;\n  await spell.update({\n    [hiddenPath]: true,\n    [`flags.dnd5e_classpack.-=${concentrationFlag}`]: null\n  });\n  return;\n}\nif (args[0] === \"on\") return;\n\nconst pass = args[0].macroPass;\nconst caster = workflow.actor;\nconst spell = caster.items.get(workflow.item.id);\nconst sustained = workflow.activity.id === sustainId;\n\nif (pass === \"preItemRoll\") {\n  if (!sustained) return;\n  const concentration = spell.getFlag(\"dnd5e_classpack\", concentrationFlag);\n  if (!concentration || !fromUuidSync(concentration)?.active) return false;\n}\nif (pass !== \"postActiveEffects\") return;\n\nif (!sustained) {\n  const concentration = caster.effects.get(workflow.concentrationId);\n  if (concentration?.active && caster.effects.some(effect =>\n    effect.active && effect.system.origin?.profile === sustainEffectId\n    && effect.system.origin.effect === concentration.uuid\n  )) {\n    const parts = spell.system.activities.get(sustainId).toObject().damage.parts;\n    parts[0].number = Math.max(spell.system.level, workflow.spellLevel);\n    await spell.update({\n      [`flags.dnd5e_classpack.${concentrationFlag}`]: concentration.uuid,\n      [hiddenPath]: false,\n      [`system.activities.${sustainId}.damage.parts`]: parts\n    });\n  }\n}\n\nconst { autoApplyDamage } = MidiQOL.configSettings();\nif (!autoApplyDamage.includes(\"yes\")) return;\n\nconst damage = workflow.damageList?.find(row => row.wasHit);\nif (!damage) return;\nif (autoApplyDamage === \"yesCardNPC\" && fromUuidSync(damage.actorUuid)?.type === \"character\") return;\n\nconst absorbed = part => part.active?.absorption || part.active?.type?.absorption;\nconst { defaultDamage, combinedDamage } = damage.damageDetails;\nconst necrotic = defaultDamage\n  .filter(part => part.type === \"necrotic\" && part.value > 0 && !absorbed(part))\n  .reduce((total, part) => total + part.value, 0);\n// Midi may leave the separate other-damage row in damageList. Read the combined bucket on that row too.\nconst total = combinedDamage\n  .filter(part => ![\"healing\", \"temphp\", \"maximum\", \"vitality\", \"midi-none\"].includes(part.type) && !absorbed(part))\n  .reduce((sum, part) => sum + part.value, 0);\nconst dealt = Math.min(necrotic, total);\nconst healing = Math.floor(dealt / 2);\nif (healing <= 0) return;\n\nconst healingDamage = [{ value: healing, type: \"healing\", properties: new Set([\"mgc\"]) }];\nif (autoApplyDamage === \"yesCardNPC\" && caster.type === \"character\") {\n  await caster.applyDamage(healingDamage);\n} else {\n  await MidiQOL.applyTokenDamage(\n    healingDamage, healing, new MidiQOL.TokenDocumentSet([workflow.tokenDocument]),\n    spell, new MidiQOL.TokenDocumentSet(), { workflow }\n  );\n}\n\nconst card = workflow.chatCard;\nif (card) await MidiQOL.addCardNote(card, `<p>吸血鬼之触：${dealt} 点暗蚀伤害，回复 ${healing} 点生命值。</p>`, {\n  anchor: \"bottom\", key: \"classpack-vampiric-healing\",\n  whisper: card.blind ? game.users.filter(user => user.isGM).map(user => user.id) : card.whisper\n});\n",
        "author": "WqWGW8MuBm7BNHxt",
        "ownership": {
          "default": 3
        },
