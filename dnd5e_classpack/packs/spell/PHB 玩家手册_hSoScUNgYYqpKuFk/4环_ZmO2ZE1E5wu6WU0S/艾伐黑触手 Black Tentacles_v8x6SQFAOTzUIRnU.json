        "macroData": {
          "name": "区域豁免与束缚来源",
          "command": "const pass = args[0]?.macroPass;\n// OverTime uses this DIME through ActivityMacro|sourceActivityUuid.\nif (pass === \"preItemRoll\" && workflow.workflowOptions?.overTimeEffectUuid &&\n  typeof macroItem !== \"undefined\" && macroItem.uuid !== workflow.item.uuid) {\n  const combat = game.combat;\n  const token = combat?.combatant?.token;\n  const effect = await fromUuid(workflow.workflowOptions.overTimeEffectUuid);\n  if (!combat?.active || !token?.actor || effect?.parent?.uuid !== token.actor.uuid) return;\n  const scene = token.parent;\n  const regionUuid = effect.flags?.dnd5e_classpack?.regionUuid;\n  const region = (regionUuid ? await fromUuid(regionUuid) : null) ??\n    Array.from(scene?.regions ?? []).find(r => r.behaviors.some(b =>\n      b.type === \"midi-qol.regionActivity\" && b.system.sourceItemUuid === macroItem.uuid));\n  const behavior = region?.behaviors.find(b => b.type === \"midi-qol.regionActivity\" &&\n    b.system.sourceItemUuid === macroItem.uuid && b.system.oncePerTurn && !b.disabled);\n  if (!behavior) return;\n  const repeated = macroItem.system.activities.get(macroItem.flags.dnd5e_classpack.regionAutomation.repeated);\n  if (!repeated) return;\n  const key = `regionTriggers.${behavior.id}.${token.id}-${repeated.id}`;\n  const value = `${combat.round}.${combat.turn}`;\n  if (game.user.isGM) await combat.setFlag(\"midi-qol\", key, value);\n  else await MidiQOL.socket().executeAsGM(\"_gmSetFlag\", {\n    actorUuid: combat.uuid, base: \"midi-qol\", key, value\n  });\n  return;\n}\nfunction ownEffect(effect, role) {\n  if (effect.flags?.dnd5e_classpack?.regionEffect !== role) return false;\n  const itemUuid = workflow.item.uuid;\n  return [effect.origin, ...Object.values(effect.system?.origin ?? {}), effect._stats?.duplicateSource,\n    effect.flags?.dnd5e_classpack?.sourceItemUuid].some(uuid => typeof uuid === \"string\" &&\n      (uuid === itemUuid || uuid.startsWith(itemUuid + \".\")));\n}\nif (pass === \"preItemRoll\") {\n  const target = Array.from(workflow.targets ?? [])[0];\n  if (!target?.actor) return false;\n  if (Array.from(target.actor.appliedEffects ?? target.actor.effects).some(e =>\n    !e.disabled && !e.isSuppressed && ownEffect(e, \"blackTentacles-binding\"))) return false;\n}\nif (pass === \"postActiveEffects\") {\n  const dependentOn = MidiQOL.getConcentrationEffect(workflow.actor, workflow.item)?.uuid;\n  for (const target of workflow.targets ?? []) {\n    const token = target.document ?? target;\n    const region = Array.from(token.parent?.regions ?? []).find(r => r.behaviors.some(b =>\n      b.type === \"midi-qol.regionActivity\" && b.system.sourceItemUuid === workflow.item.uuid));\n    const updates = Array.from(target.actor?.appliedEffects ?? target.actor?.effects ?? [])\n      .filter(e => ownEffect(e, \"blackTentacles-binding\")).map(e => {\n        const changes = foundry.utils.deepClone(e.system.changes);\n        const suffix = \", macro=[preItemRoll]ActivityMacro|\" + workflow.activity.uuid;\n        for (const change of changes) if (change.key.startsWith(\"flags.midi-qol.OverTime\") &&\n          !change.value.endsWith(suffix)) change.value += suffix;\n        return { _id: e.id, \"system.changes\": changes,\n          \"flags.dnd5e_classpack.sourceItemUuid\": workflow.item.uuid,\n          ...(region ? { \"flags.dnd5e_classpack.regionUuid\": region.uuid } : {}),\n          ...(dependentOn ? { \"flags.dnd5e.dependentOn\": dependentOn } : {}) };\n      });\n    if (updates.length) await MidiQOL.socket().executeAsGM(\"updateEffects\", { actorUuid: target.actor.uuid, updates });\n  }\n}\n"
        },
