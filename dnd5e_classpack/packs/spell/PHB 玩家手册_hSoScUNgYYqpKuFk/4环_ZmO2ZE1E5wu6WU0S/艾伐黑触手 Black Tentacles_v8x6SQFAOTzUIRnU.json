        "macroData": {
          "name": "区域：放置后补 Entry",
          "command": "if (args[0]?.macroPass === \"templatePlaced\") {\n  for (const uuid of workflow.templateUuids ?? []) {\n    const region = await fromUuid(uuid);\n    if (region?.documentName !== \"Region\") continue;\n    const behavior = region.behaviors.find(b => b.type === \"midi-qol.regionActivity\" &&\n      b.system.sourceItemUuid === workflow.item.uuid && !b.flags?.dnd5e_classpack?.regionPassive);\n    if (!behavior) continue;\n    const rules = foundry.utils.deepClone(behavior.system.rules);\n    const repeat = rules.find(r => [\"turnStart\", \"turnEnd\"].includes(r.trigger) && r.action === \"useActivity\");\n    if (!repeat?.targetUuid) continue;\n    if (!rules.some(r => r.trigger === \"entry\" && r.action === \"useActivity\" && r.targetUuid === repeat.targetUuid)) {\n      rules.push({ trigger: \"entry\", action: \"useActivity\", targetUuid: repeat.targetUuid });\n    }\n    const behaviors = [];\n    if (!region.behaviors.some(b => b.type === \"dnd5e.difficultTerrain\")) {\n      behaviors.push({ name: workflow.item.name + \"：困难地形\", type: \"dnd5e.difficultTerrain\",\n        system: { magical: true, types: [], ignoredDispositions: [] } });\n    }\n    await MidiQOL.socket().executeAsGM(\"setupRegion\", { regionUuid: region.uuid,\n      update: { behaviors: [{ _id: behavior.id, system: { rules } }] }, behaviors });\n  }\n}\n"
