    "dae": {
      "macro": {
        "name": "闪电牵引 Lightning Lure",
        "img": "icons/magic/lightning/bolt-strike-beam-purple.webp",
        "type": "script",
        "scope": "global",
        "command": "const caster = workflow.token;\nconst target = workflow.failedSaves.documents[0];\nif (!target) return;\n\nconst units = caster.document.parent.grid.units;\nconst pullDistance = dnd5e.utils.convertLength(10, \"ft\", units, { strict: false });\nawait dnd5eClasspack.pull(target, caster, pullDistance, { avoidOccupied: true });\n\nconst damageRange = dnd5e.utils.convertLength(5, \"ft\", units, { strict: false });\nconst distance = MidiQOL.computeDistance(caster, target);\nif (distance < 0 || distance > damageRange) return;\n\nconst level = workflow.actor.system.details.level;\nconst dice = 1 + [5, 11, 17].filter(threshold => level >= threshold).length;\nconst roll = await new CONFIG.Dice.DamageRoll(`${dice}d8[lightning]`, {}, { type: \"lightning\" }).evaluate();\nconst damage = new MidiQOL.DamageOnlyWorkflow(\n  workflow.actor, caster, roll.total, \"lightning\", [target.object], roll,\n  { flavor: workflow.item.name, itemCardUuid: \"new\" }\n);\nawait damage.ready;\n",
        "author": "WqWGW8MuBm7BNHxt",
        "ownership": {
          "default": 3
        },
