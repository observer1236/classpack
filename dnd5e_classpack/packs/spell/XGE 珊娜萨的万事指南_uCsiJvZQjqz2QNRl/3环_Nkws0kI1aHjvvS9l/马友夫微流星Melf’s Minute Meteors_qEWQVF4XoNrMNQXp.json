    "dae": {
      "macro": {
        "name": "马友夫微流星Melf’s Minute Meteors",
        "img": "icons/magic/earth/projectiles-fire-stone-salvo.webp",
        "type": "script",
        "scope": "global",
        "command": "const spell = await fromUuid(macroItem.uuid);\nconst release = spell.system.activities.find(a => a.identifier === \"release-meteors\");\nconst explosion = spell.system.activities.find(a => a.identifier === \"meteor-explosion\");\n// 消耗会更新物品并重建行动，始终读取当前行动的次数。\nconst uses = () => spell.system.activities.get(explosion.id).uses;\n\nif (args[0] === \"off\") {\n  await dnd5eClasspack.removeFavorite(release.uuid);\n  await dnd5eClasspack.hideActivity(release.uuid);\n  await spell.update({\n    [`system.activities.${explosion.id}.uses.spent`]: Number(uses().max),\n    \"flags.world.minuteMeteors\":\n      new foundry.data.operators.ForcedDeletion()\n  });\n  return;\n}\nif (args[0] === \"on\") return;\n\nconst pass = args[0].macroPass;\nconst identifier = workflow.activity.identifier;\nif (![\"cast-meteors\", \"release-meteors\"].includes(identifier)) return;\n\nasync function chooseCount(initial = false) {\n  const remaining = uses().value;\n  if (remaining <= 0) return 0;\n  const options = [];\n  if (initial) options.push({ value: \"0\", label: \"暂不释放\" });\n  options.push({ value: \"1\", label: \"1 颗\" });\n  if (remaining >= 2) options.push({ value: \"2\", label: \"2 颗\" });\n  return Number(await dnd5eClasspack.dialogUtils.selectDialog(\n    \"马友夫微流星\", \"\", {\n      label: `剩余 ${remaining} 颗`, name: \"count\", options: { options }\n    }\n  ));\n}\n\nasync function explode(count) {\n  const state = spell.getFlag(\"world\", \"minuteMeteors\");\n  for (let i = 0; i < count; i++) {\n    if (uses().value <= 0) break;\n    const spent = uses().spent;\n    // 仅解除本次使用副本的隐藏；角色上的爆炸行动始终隐藏。\n    const copy = spell.clone({\n      [`system.activities.${explosion.id}.flags.dnd5e_classpack.hidden`]: false,\n      [`system.activities.${explosion.id}.midiProperties.forceConsumeDialog`]: \"never\",\n      [`system.activities.${explosion.id}.midiProperties.forceDamageDialog`]: \"never\",\n      [`system.activities.${explosion.id}.save.dc.calculation`]: \"\",\n      [`system.activities.${explosion.id}.save.dc.formula`]: String(state.dc),\n      [`system.activities.${explosion.id}.save.dc.bonus`]: \"\"\n    }, { keepId: true });\n    const result = await MidiQOL.completeActivityUse(\n      copy.system.activities.get(explosion.id),\n      {\n        scaling: 0,\n        create: { measuredTemplate: true },\n        consume: { resources: true, spellSlot: false, action: false },\n        concentration: { begin: false },\n        midiOptions: { ignoreUserTargets: true }\n      },\n      { configure: false },\n      { create: true }\n    );\n    if (!result || result.aborted || uses().spent === spent) break;\n  }\n  if (uses().value <= 0) {\n    const effect = await fromUuid(state.effect);\n    const concentration = MidiQOL.getConcentrationEffect(spell.actor, spell);\n    if (concentration) await spell.actor.endConcentration(concentration.id);\n    else if (effect) await effect.delete();\n  }\n}\n\nif (pass === \"preItemRoll\" && identifier === \"release-meteors\") {\n  args[0].options.dialog.configure = false;\n  workflow.meteorCount = await chooseCount();\n  if (!workflow.meteorCount) return false;\n}\n\nif (pass !== \"postActiveEffects\") return;\n\nif (identifier === \"cast-meteors\") {\n  const effect = spell.actor.effects.find(e => e.system?.origin?.message === workflow.itemCardUuid);\n  if (!effect) return ui.notifications.warn(\"马友夫微流星：未找到本次施法应用的自身效果。\");\n  const maximum = 6 + 2 * Math.max(0, workflow.spellLevel - 3);\n  await spell.update({\n    [`system.activities.${explosion.id}.uses.max`]: String(maximum),\n    [`system.activities.${explosion.id}.uses.spent`]: 0,\n    \"flags.world.minuteMeteors\": { effect: effect.uuid, dc: explosion.save.dc.value }\n  });\n  await dnd5eClasspack.hideActivity(release.uuid, false);\n  await dnd5eClasspack.addFavorite(release.uuid);\n  await explode(await chooseCount(true));\n} else {\n  await explode(workflow.meteorCount);\n}",
        "author": "dvg25zW2MvzsvMOU",
