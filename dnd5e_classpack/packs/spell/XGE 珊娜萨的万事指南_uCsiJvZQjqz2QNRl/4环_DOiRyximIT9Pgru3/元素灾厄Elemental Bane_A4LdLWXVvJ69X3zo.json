    "dnd5e": {},
    "dae": {
      "macro": {
        "name": "元素灾厄Elemental Bane",
        "img": "icons/magic/death/skull-horned-worn-fire-blue.webp",
        "type": "script",
        "scope": "global",
        "command": "const mode = args[0];\n\nif (mode === \"trigger\") {\n  const data = args[args.length - 1];\n  const effect = await fromUuid(data.effectUuid);\n  if (!effect || effect.disabled) return;\n  const state = effect.getFlag(\"world\", \"elementalBane\");\n  const key = `${effect.uuid}:${data.turn}`;\n  const pending = globalThis.elementalBanePending ??= new Set();\n  if (state.turn === data.turn || pending.has(key)) return;\n  pending.add(key);\n  await effect.setFlag(\"world\", \"elementalBane\", {\n    ...state, turn: data.turn\n  }).finally(() => pending.delete(key));\n\n  const actor = effect.parent;\n  const roll = await new CONFIG.Dice.DamageRoll(\"2d6\", {}, {\n    type: state.damageType, properties: [\"mgc\", \"spell\"], isCritical: false\n  }).evaluate();\n  // 额外伤害不沿用触发伤害的豁免倍数，不再重复扣除一次固定减伤。\n  const calculated = actor.calculateDamage([{\n    type: state.damageType, value: roll.total, properties: new Set([\"mgc\", \"spell\"])\n  }], { ignore: { resistance: true, modification: true } });\n  await roll.toMessage({\n    speaker: foundry.documents.ChatMessage.getSpeaker({ actor }),\n    flavor: \"元素灾厄：额外伤害\",\n    whisper: data.whisper, blind: data.blind\n  });\n  return { value: calculated.amount, total: roll.total };\n}\n\nconst pass = mode.macroPass;\n\nif (pass === \"prePreambleComplete\") {\n  workflow.elementalBaneType = await dnd5eClasspack.dialogUtils.selectDamageType(\n    [\"acid\", \"cold\", \"fire\", \"lightning\", \"thunder\"], macroItem.name, \"\"\n  );\n  if (!workflow.elementalBaneType) {\n    await workflow.refundConsumption();\n    workflow.aborted = true;\n    return;\n  }\n}\n\nif (pass === \"preActiveEffects\") {\n  const damageType = workflow.elementalBaneType;\n  for (const { _id } of workflow.activity.effects) {\n    const effect = workflow.item.effects.get(_id);\n    const changes = effect.toObject().system.changes;\n    changes.push({\n      key: \"system.traits.dr.value\", value: `-${damageType}`,\n      type: \"custom\", phase: \"final\", priority: 100\n    }, {\n      key: \"flags.midi-qol.onUseMacroName\",\n      value: `ItemMacro.${workflow.item.uuid},isDamaged`,\n      type: \"custom\", phase: \"initial\", priority: 20\n    });\n    effect.updateSource({\n      \"system.changes\": changes,\n      \"flags.world.elementalBane\": { damageType, itemUuid: workflow.item.uuid }\n    });\n  }\n}\n\nif (pass !== \"isDamaged\") return;\nconst { actor, token } = mode.options;\nconst damage = workflow.damageItem?.targetUuid === token.document.uuid\n  ? workflow.damageItem\n  : workflow.damageList.find(d => d.targetUuid === token.document.uuid);\nif (!damage) return;\n\nconst combat = game.combat;\nconst turn = combat?.started ? `${combat.id}:${combat.round}:${combat.turn}`\n  : (workflow.elementalBaneTurn ??= foundry.utils.randomID());\n\nfor (const effect of actor.effects) {\n  const state = effect.getFlag(\"world\", \"elementalBane\");\n  if (!state || effect.disabled || state.turn === turn) continue;\n  if (!damage.damageDetail.some(d => d.type === state.damageType && d.value > 0)) continue;\n\n  const result = await socketlib.modules.get(\"dae\").executeAsGM(\"executeMacro\", {\n    action: \"trigger\",\n    lastArg: {\n      effectUuid: effect.uuid, turn,\n      whisper: workflow.chatCard?.whisper ?? [], blind: workflow.chatCard?.blind ?? false\n    },\n    macroData: { change: { key: \"macro.itemMacro\" }, name: state.itemUuid }\n  });\n  if (!result) continue;\n  MidiQOL.modifyDamageBy({\n    damageItem: damage, value: result.value, type: state.damageType,\n    reason: `${macroItem.name}：2d6 = ${result.total}`\n  });\n}",
        "author": "dvg25zW2MvzsvMOU",
        "ownership": {
          "default": 3
        },
