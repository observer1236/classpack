{
  "_id": "NOdNl8paEppqJs03",
  "name": "奥法骑士 Eldritch Knight",
  "type": "subclass",
  "img": "icons/magic/defensive/shield-barrier-glowing-blue.webp",
  "effects": [],
  "folder": "dqzc0s0n6BEoFqEm",
