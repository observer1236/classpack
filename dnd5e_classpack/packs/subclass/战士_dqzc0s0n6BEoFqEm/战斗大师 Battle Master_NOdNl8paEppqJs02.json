{
  "_id": "NOdNl8paEppqJs02",
  "name": "战斗大师 Battle Master",
  "type": "subclass",
  "img": "icons/skills/melee/swords-parry-block-blue.webp",
  "effects": [],
  "folder": "dqzc0s0n6BEoFqEm",
