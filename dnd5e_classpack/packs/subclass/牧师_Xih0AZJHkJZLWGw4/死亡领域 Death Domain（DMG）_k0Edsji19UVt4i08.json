  "_id": "k0Edsji19UVt4i08",
  "name": "死亡领域 Death Domain(DMG)",
  "type": "subclass",
  "img": "icons/magic/death/skull-humanoid-white-red.webp",
  "effects": [],
  "folder": "Xih0AZJHkJZLWGw4",
